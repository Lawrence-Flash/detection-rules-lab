# Linux Curl Piped to a Shell
# id: a33f0692-dd1b-43cc-86b2-4f0def72b647
# source: rules/linux/curl_pipe_shell.yml
# format: Splunk SPL
# Field names are the Sigma field names. No product pipeline was applied.
# Generated by python3 -m rulelab convert. Do not edit by hand.
image IN ("*/bash", "*/sh", "*/dash", "*/zsh") command_line="*curl *" command_line IN ("*| bash*", "*| sh*", "*|bash*", "*|sh*")
