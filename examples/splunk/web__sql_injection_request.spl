# Web SQL Injection Request
# id: 48855188-f29f-4899-9dca-b478343b68e7
# source: rules/web/sql_injection_request.yml
# format: Splunk SPL
# Field names are the Sigma field names. No product pipeline was applied.
# Generated by python3 -m rulelab convert. Do not edit by hand.
uri IN ("*union select*", "*union all select*") OR uri IN ("*' or 1=1*", "*' or '1'='1*", "* or 1=1--*") OR user_agent="*sqlmap*"
