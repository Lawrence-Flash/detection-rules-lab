# Windows LSASS Memory Access
# id: 209d53d4-e7ea-4b06-9c19-b89a824fe768
# source: rules/windows/lsass_process_access.yml
# format: Splunk SPL
# Field names are the Sigma field names. No product pipeline was applied.
# Generated by python3 -m rulelab convert. Do not edit by hand.
EventID=10 TargetImage="*\\lsass.exe" GrantedAccess IN ("0x1010", "0x1410", "0x1438", "0x143a", "0x1fffff") NOT (SourceImage IN ("*\\csrss.exe", "*\\wininit.exe"))
